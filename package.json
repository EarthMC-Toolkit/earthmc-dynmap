{
  "name": "earthmc-dynmap-plus",
  "private": true,
  "type": "module",
  "scripts": {
    "cleandeps": "bun -e \"await require('node:fs').promises.rm('./node_modules', { recursive: true, force: true })\"",
    "borders": "bun build-borders.ts",
    "userscript": "bun build-userscript.ts",
    "extension": "bun build-extension.ts",
    "build": "bun run userscript && bun run extension"
  },
  "devDependencies": {
    "@archiver/archiver": "latest",
    "@types/chrome": "latest",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "esbuild": "^0.28.2",
    "mapshaper": "github:Owen3H/mapshaper-typed"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
